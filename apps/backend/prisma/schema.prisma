generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique
  hashedPassword String
  role           Role     @default(USER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  libraryEntries LibraryEntry[]
  aiSettings     AiSettings?
  aiChats        AiConversation[]
  priceWatches   PriceWatch[]
  notifications  Notification[]
  apiTokens      ApiToken[]

  @@index([username])
}

// External services configured by the admin in the app. One row per service — the
// key belongs to the whole installation, not to each user.
enum IntegrationProvider {
  IGDB
  // IsThereAnyDeal: prices; only the API key is used (secret), clientId stays empty
  ITAD
}

model Integration {
  provider  IntegrationProvider @id
  clientId  String
  // Encrypted with TOKEN_ENCRYPTION_KEY (AES-256-GCM); never leaves the backend
  secret    String
  updatedAt DateTime            @updatedAt
}

// --- Shelf ---------------------------------------------------------------------------

// Where a game sits on a user's shelf. The four shelves on Home
// group them: playing (PLAYING, PAUSED), finished (FINISHED_MAIN,
// FINISHED_EXTRAS, COMPLETED_100), to play (PLAN_TO_PLAY) and dropped.
enum LibraryStatus {
  PLAYING
  PAUSED
  PLAN_TO_PLAY
  FINISHED_MAIN
  FINISHED_EXTRAS
  COMPLETED_100
  DROPPED
}

// Minimal copy of an IGDB game — only what the shelf needs to render
// without calling the API. Shared by all users; the rest of the details always
// come from IGDB.
model Game {
  igdbId           Int       @id
  name             String
  slug             String?
  coverImageId     String?
  releaseYear      Int?
  platforms        String[]
  genres           String[]  @default([])
  // Average time to beat (hours), from IGDB players: main story,
  // main + extras and 100%. Stats use it when the user
  // didn't enter the hours.
  ttbMain          Float?
  ttbExtras        Float?
  ttbCompletionist Float?
  // When genres and times were fetched from IGDB (null = never)
  factsCheckedAt   DateTime?
  // Where the game is found by the price services: the Steam appid (from IGDB) and
  // each service's own id. Looked up once; priceIdsCheckedAt says when
  steamAppId        Int?
  itadId            String?
  cheapSharkId      String?
  priceIdsCheckedAt DateTime?
  updatedAt        DateTime  @updatedAt

  libraryEntries LibraryEntry[]
  priceWatches   PriceWatch[]
  prices         GamePrice[]
  pricePoints    PricePoint[]
}

model LibraryEntry {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId      Int
  game        Game          @relation(fields: [gameId], references: [igdbId])
  status      LibraryStatus
  hoursPlayed Float?
  startedAt   DateTime?     @db.Date
  finishedAt  DateTime?     @db.Date
  // Personal rating from 1 to 10
  rating      Int?
  notes       String?
  // Where the user played it (free text, usually one of the game's platforms)
  platform    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, gameId])
  @@index([userId, status])
}

// --- Assistant (AI) --------------------------------------------------------------------

// Assistant provider. For now only Anthropic (Claude).
enum AiProvider {
  ANTHROPIC
}

// Each user's assistant key and model: everyone uses their own account.
model AiSettings {
  userId    String     @id
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  AiProvider @default(ANTHROPIC)
  // Encrypted with TOKEN_ENCRYPTION_KEY (AES-256-GCM); never leaves the backend
  apiKey    String
  // The last 4 characters, to show which key is stored
  keyHint   String
  model     String
  updatedAt DateTime   @updatedAt
}

// A conversation with the assistant, kept so it can be picked up again later. The title
// is the first question, shortened.
model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

enum AiMessageRole {
  USER
  ASSISTANT
}

// One message of a conversation, in order of id. An answer is created empty and
// `pending` while it is being written; it is saved in full when it ends.
model AiMessage {
  id             Int            @id @default(autoincrement())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole
  content        String         @default("")
  // IGDB searches made for this answer: [{ name, query }]
  tools          Json?
  // Shelf changes proposed in this answer, waiting for the user or already decided
  actions        Json?
  // Why the answer failed or stopped ("stopped" and "interrupted" are codes)
  error          String?
  pending        Boolean        @default(false)
  createdAt      DateTime       @default(now())

  @@index([conversationId, id])
}

// --- Prices -----------------------------------------------------------------------------

// Where prices come from: IsThereAnyDeal (with a key, dozens of shops, local currency) or
// CheapShark (no key, PC shops, US dollars).
enum PriceProvider {
  ITAD
  CHEAPSHARK
}

// The installation's price settings: a single row (id 1), created with the defaults the
// first time it is read.
model PriceSettings {
  id          Int       @id @default(1)
  enabled     Boolean   @default(true)
  // ISO 3166-1 alpha-2: decides the shops and the currency (IsThereAnyDeal only)
  country     String    @default("PT")
  // Hours between the automatic checks of the watched games
  everyHours  Int       @default(6)
  lastCheckAt DateTime?
  lastError   String?
  updatedAt   DateTime  @updatedAt
}

// The latest prices of a game in a country: the best one and every shop's.
model GamePrice {
  gameId     Int
  game       Game          @relation(fields: [gameId], references: [igdbId], onDelete: Cascade)
  country    String
  provider   PriceProvider
  currency   String
  // Best price now (null = not sold anywhere covered)
  price      Float?
  regular    Float?
  cut        Int?
  shop       String?
  url        String?
  // The lowest price ever recorded by the service
  lowest     Float?
  lowestShop String?
  lowestAt   DateTime?
  // Every shop: [{ shop, price, regular, cut, url, expiry }], cheapest first
  deals      Json
  checkedAt  DateTime

  @@id([gameId, country])
}

// The best price of a game on each day it was checked, for the chart on the game's page.
model PricePoint {
  gameId   Int
  game     Game     @relation(fields: [gameId], references: [igdbId], onDelete: Cascade)
  country  String
  day      DateTime @db.Date
  price    Float
  currency String

  @@id([gameId, country, day])
}

// A game the user follows the price of (favourites). An alert is sent when the price
// reaches the target, or when it goes on sale if there's no target.
model PriceWatch {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId        Int
  game          Game     @relation(fields: [gameId], references: [igdbId], onDelete: Cascade)
  targetPrice   Float?
  // The price of the last alert: the same deal isn't announced twice, and a lower one is.
  // Cleared when the deal ends, so the next one is announced again.
  notifiedPrice Float?
  createdAt     DateTime @default(now())

  @@unique([userId, gameId])
}

// --- Notifications ------------------------------------------------------------------------

enum NotificationKind {
  PRICE_DROP
}

// Something to tell the user: shown in the site and fetched by the Android app, which
// turns it into a phone notification. The data column holds the facts (game, price, shop…) and each
// client words it in its own language.
model Notification {
  id        Int              @id @default(autoincrement())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  gameId    Int?
  data      Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, id])
}

// --- API -------------------------------------------------------------------------------

// Tokens for calling the API from other programs (Authorization: Bearer gtv_…). Each one
// acts as the user who created it, with that user's role. The token itself is only shown
// once, when created; only its SHA-256 is stored.
model ApiToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  // The first characters ("gtv_Ab12Cd"), to tell tokens apart in the list
  prefix     String
  // Only GET requests
  readOnly   Boolean   @default(false)
  // null = never expires
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// --- Backups ---------------------------------------------------------------------------

// The installation's backup settings: a single row (id 1), created with the defaults the
// first time it is read.
model BackupSettings {
  id           Int       @id @default(1)
  automatic    Boolean   @default(true)
  // "HH:MM", in the server's time zone
  time         String    @default("03:30")
  // Days a backup is kept (0 = forever)
  keepDays     Int       @default(14)
  // null = the default folder (BACKUP_DIR)
  directory    String?
  // Day ("YYYY-MM-DD") of the last automatic backup, so a restart doesn't repeat it
  lastAutoDate String?
  lastRunAt    DateTime?
  lastOk       Boolean?
  lastError    String?
  lastFile     String?
  updatedAt    DateTime  @updatedAt
}
