<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed (the server can be opened by its LAN address, e.g.
     http://192.168.1.50), and besides the system certificate authorities the app trusts
     the ones the user installed on the phone: a server with a self-signed certificate
     works once its CA is installed under Settings → Security → Encryption & credentials. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
