{
  "name": "@gametracker/shared",
  "version": "1.0.1",
  "private": true,
  "description": "Types and constants shared by the server and the web app.",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/mark-dist.mjs",
    "dev": "tsc -p tsconfig.esm.json --watch"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "license": "AGPL-3.0-only"
}
