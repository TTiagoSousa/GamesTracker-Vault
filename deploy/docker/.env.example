# GamesTracker Vault — Docker configuration. Copy to .env next to docker-compose.yml.
# install.sh writes this file with random secrets; edit it and run `docker compose up -d`.

# --- Secrets (required) ------------------------------------------------------------------
# Generate each with:  openssl rand -hex 32
# Database password. Letters and digits only (it goes inside a URL).
DB_PASSWORD=
# Signs the login sessions. Changing it logs everyone out.
JWT_SECRET=
# ⚠ Never change it after the first start: it encrypts the IGDB and Claude keys stored in
# the database. Base64 of 32 bytes:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- First account -----------------------------------------------------------------------
# Created on the first start, while the database has no users. Change the password in the
# app afterwards (Settings → Account); these values are not used again.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Network -----------------------------------------------------------------------------
# Port on this machine.
PORT=8080
# The address people open, without a trailing slash (e.g. https://games.example.com).
APP_URL=http://localhost:8080
# Proxies allowed to report the original protocol (X-Forwarded-Proto), which decides
# whether the session cookie is "secure". The default trusts private networks, where a
# reverse proxy usually is. Accepts "true", a hop count or a list of addresses.
TRUST_PROXY=loopback, uniquelocal

# --- Other -------------------------------------------------------------------------------
# Time zone for dates and the backup schedule, e.g. Europe/Lisbon.
TZ=Etc/UTC
# Image tag: "latest" or a release such as 1.0.0. Pin it to update on your own schedule.
VERSION=latest
